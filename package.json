{
  "name": "a2human",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "NEXT_PUBLIC_API_ORIGIN=\"${NEXT_PUBLIC_API_ORIGIN-}\" next build",
    "build:pages": "GITHUB_PAGES=1 NEXT_PUBLIC_PAGES=1 NEXT_PUBLIC_API_ORIGIN=\"${NEXT_PUBLIC_API_ORIGIN:-https://API_ORIGIN_TBD}\" next build && node scripts/pages-404.mjs",
    "start": "bash scripts/start.sh",
    "api": "python3 -m uvicorn a2human.main:app --host 127.0.0.1 --port 3848",
    "lint": "eslint",
    "test": "python3 -m pytest && node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "license": "MIT"
}
